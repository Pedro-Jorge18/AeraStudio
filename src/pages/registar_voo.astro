---
import OpsLayout from '../layouts/OpsLayout.astro';
import { db, hojeISO } from '../lib/db';

const pdo = db();
let sucesso = false;
let erro: string | null = null;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const val = (k: string) => (form.get(k) ?? '').toString();
    const stmt = pdo.prepare(
      `INSERT INTO voos (local_id, data, hora_inicio, duracao_min, condicoes_vento, bateria_usada_pct, piloto, notas)
       VALUES (@local_id, @data, @hora_inicio, @duracao_min, @condicoes_vento, @bateria, @piloto, @notas)`,
    );
    stmt.run({
      local_id: parseInt(val('local_id'), 10),
      data: val('data'),
      hora_inicio: val('hora_inicio') || null,
      duracao_min: val('duracao_min') !== '' ? parseInt(val('duracao_min'), 10) : null,
      condicoes_vento: val('condicoes_vento').trim() || null,
      bateria: val('bateria_usada_pct') !== '' ? parseInt(val('bateria_usada_pct'), 10) : null,
      piloto: val('piloto').trim() || null,
      notas: val('notas').trim() || null,
    });
    sucesso = true;
  } catch (e) {
    erro = 'Não foi possível guardar: ' + (e as Error).message;
  }
}

// --- Fase 2: verificação de compliance (seguro e AAN válidos) ---
const hoje = hojeISO();
const documentos_criticos: [string, string][] = [
  ['seguro', 'Seguro de responsabilidade civil'],
  ['aan', 'Autorização de Operador (AAN)'],
];
const avisos_compliance: string[] = [];
for (const [tipo, rotulo] of documentos_criticos) {
  const valido = pdo
    .prepare(
      `SELECT data_validade FROM documentos
       WHERE tipo = @tipo AND (data_validade IS NULL OR data_validade >= @hoje)
       ORDER BY data_validade IS NULL, data_validade DESC LIMIT 1`,
    )
    .get({ tipo, hoje });
  if (!valido) {
    avisos_compliance.push(`${rotulo} — sem registo válido (em falta ou expirado).`);
  }
}

const locais = pdo.prepare('SELECT id, nome FROM locais ORDER BY nome ASC').all() as any[];

const voos_recentes = pdo
  .prepare(
    `SELECT v.id, v.data, v.duracao_min, v.condicoes_vento, l.nome AS local_nome
     FROM voos v JOIN locais l ON l.id = v.local_id
     ORDER BY v.data DESC, v.id DESC LIMIT 8`,
  )
  .all() as any[];

const hoje_input = hojeISO();
---
<OpsLayout titulo="Registar voo">
  {sucesso && <div class="mensagem-sucesso">Voo registado.</div>}
  {erro && <div class="mensagem-sucesso" style="border-color:var(--erro); color:var(--erro);">{erro}</div>}

  {avisos_compliance.length > 0 && (
    <div class="cartao" style="border-color:var(--erro);">
      <h2 style="color:var(--erro);">⚠ Compliance em falta</h2>
      <ul>
        {avisos_compliance.map((aviso: string) => <li class="texto-suave">{aviso}</li>)}
      </ul>
      <p class="texto-suave">Podes continuar a registar o voo, mas confirma isto em <a href="/documentos">Documentos</a> antes de voar.</p>
    </div>
  )}

  <div class="cartao">
    <h2>Novo voo</h2>
    {locais.length === 0 ? (
      <p class="vazio">Ainda não há locais no catálogo — vê <a href="/locais">locais</a>.</p>
    ) : (
      <form method="post">
        <label for="local_id">Local</label>
        <select name="local_id" id="local_id" required>
          {locais.map((l: any) => <option value={l.id}>{l.nome}</option>)}
        </select>

        <label for="data">Data</label>
        <input type="date" name="data" id="data" value={hoje_input} required />

        <label for="hora_inicio">Hora de início (opcional)</label>
        <input type="time" name="hora_inicio" id="hora_inicio" />

        <label for="duracao_min">Duração (minutos)</label>
        <input type="number" name="duracao_min" id="duracao_min" min="0" />

        <label for="condicoes_vento">Condições de vento</label>
        <input type="text" name="condicoes_vento" id="condicoes_vento" placeholder="ex: fraco, 10-15 km/h" />

        <label for="bateria_usada_pct">Bateria usada (%)</label>
        <input type="number" name="bateria_usada_pct" id="bateria_usada_pct" min="0" max="100" />

        <label for="piloto">Piloto</label>
        <input type="text" name="piloto" id="piloto" />

        <label for="notas">Notas</label>
        <textarea name="notas" id="notas"></textarea>

        <button type="submit">Guardar voo</button>
      </form>
    )}
  </div>

  <div class="cartao">
    <h2>Últimos voos</h2>
    {voos_recentes.length === 0 ? (
      <p class="vazio">Ainda não há voos registados.</p>
    ) : (
      <table>
        <tr><th>Data</th><th>Local</th><th>Duração</th><th>Vento</th></tr>
        {voos_recentes.map((v: any) => (
          <tr>
            <td>{v.data}</td>
            <td>{v.local_nome}</td>
            <td class="texto-suave">{v.duracao_min ? v.duracao_min + ' min' : '—'}</td>
            <td class="texto-suave">{v.condicoes_vento ?? '—'}</td>
          </tr>
        ))}
      </table>
    )}
  </div>
</OpsLayout>
