<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>AERA Studio</title>
  <meta name="description" content="AERA Studio — captura aérea no Norte de Portugal. Drone, foto e vídeo.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&display=swap">
  <link rel="stylesheet" href="/site.css">
</head>
<body>
<header id="site">
  <div id="brand" aria-label="AERA"><span class="lbox">A</span><span class="lbox">E</span><span class="lbox">R</span><span class="lbox">A</span></div>
  <nav class="main"><span class="link">Trabalhos</span><span class="link">Serviços</span><a class="link" href="/painel">Painel</a><span class="btn">Fala connosco</span></nav>
</header>

<div id="alt" aria-hidden="true">
  <div class="ticks"><span>120</span><span>90</span><span>60</span><span>30</span><span>0</span></div>
  <div class="rail"><div class="fill" id="altFill"></div><div class="mk" id="altMk"></div></div>
  <div class="read"><span class="n" id="altN">120</span><span class="l"> m</span></div>
</div>

<main>
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow"><span>Porto · Portugal</span><span class="rule"></span><span class="sub">Drone · Photo · Video</span></div>
      <h1 class="hero-title display">Criamos imagens que contam <span class="serif" style="font-style:italic;font-weight:600;color:var(--gold);">histórias.</span></h1>
      <div class="hero-foot">
        <p>Estúdio de captura aérea no Norte de Portugal. Filmamos paisagem, património e marcas de um ângulo que ninguém mais vê.</p>
        <span class="btn big">Ver trabalhos ↓</span>
      </div>
      <div class="couple-hero">
        <img class="duo" src="/img/couple-hero.png" alt="Luísa e Pedro a acenar, de mãos dadas — Colômbia e Portugal" />
      </div>
    </section>
  </div>

  <div class="wrap">
    <div class="band">
      <div class="dots"></div>
      <img class="banddrone" src="/img/drone.png" alt="Lito X1" />
      <span class="tag" style="left:24px;bottom:22px;">▶&nbsp; Reel — Vale do Douro</span>
      <span class="shoton">◉ <b>Lito X1</b> · 4K · 250g</span>
    </div>
  </div>

  <div class="marquee"><div class="track">
    DRONE&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;PHOTO&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;VIDEO&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;AERIAL&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;PORTO&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;DRONE&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;PHOTO&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;VIDEO&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;AERIAL&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;PORTO&nbsp;&nbsp;<b>∗</b>&nbsp;&nbsp;
  </div></div>

  <div class="wrap">
    <section class="blk" id="trabalhos">
      <div class="sec-head"><h2 class="display">Trabalhos<br>selecionados</h2><span class="meta">2026 — 11 projetos</span></div>
      <div class="grid2">
        <div class="work"><div class="img" style="background:linear-gradient(150deg,#1f4038,#0e1f22);"><div class="dots"></div><span class="bdg">Reel</span></div><div class="cap"><span class="name">Gerês</span><span class="loc">Serra</span></div></div>
        <div class="work"><div class="img" style="background:linear-gradient(150deg,#20374f,#0d1928);"><div class="dots"></div><span class="bdg">Reel</span></div><div class="cap"><span class="name">Vale do Douro</span><span class="loc">Pinhão</span></div></div>
        <div class="work"><div class="img" style="background:linear-gradient(150deg,#2f2a48,#14111f);"><div class="dots"></div><span class="bdg">Foto</span></div><div class="cap"><span class="name">Foz do Douro</span><span class="loc">Porto</span></div></div>
        <div class="work"><div class="img" style="background:linear-gradient(150deg,#40371f,#1f1a0f);"><div class="dots"></div><span class="bdg">Reel</span></div><div class="cap"><span class="name">Costa Nova</span><span class="loc">Aveiro</span></div></div>
      </div>
    </section>

    <!-- SOBRE NÓS -->
    <section class="blk">
      <div class="sobre"><div class="inner">
        <div class="copy">
          <div class="ey">
            <span class="flagcol" style="background:linear-gradient(#fcd116 0 50%,#003893 50% 75%,#ce1126 75% 100%);"></span><span>Colômbia</span>
            <span style="color:var(--dim);">×</span>
            <span class="flagpt" style="background:linear-gradient(90deg,#046a38 0 42%,#da291c 42% 100%);"></span><span>Portugal</span>
          </div>
          <h2 class="display">Um casal,<br>dois países.</h2>
          <p>A AERA nasce de dois mundos — ela da <strong style="color:#eaf0f7;">Colômbia</strong>, ele de <strong style="color:#eaf0f7;">Portugal</strong>. Juntos criamos as imagens que contam as vossas histórias.</p>
          <p style="color:var(--dim);font-size:14px;">Porto · Portugal — desde 2026.</p>
        </div>
        <div class="sobre-duo">
          <img class="scenecard" src="/img/scene.jpg" alt="Pedro a pilotar o Lito X1 e Luísa a fotografar" />
        </div>
      </div></div>
    </section>

    <!-- MAP -->
    <section class="blk">
      <div class="maprow">
        <div class="mapwrap">
          <svg viewBox="0 0 600 470" role="img" aria-label="Mapa de locais no Norte de Portugal">
            <defs><pattern id="grid" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0 H0 V30" fill="none" stroke="#16283c" stroke-width="1"/></pattern></defs>
            <rect width="600" height="470" fill="url(#grid)"/>
            <path d="M70 0 C 95 70, 60 130, 90 190 C 120 250, 80 320, 110 390 C 130 430, 120 450, 140 470 L 0 470 L 0 0 Z" fill="rgba(31,74,90,0.16)" stroke="#2a4a5e" stroke-width="1.5"/>
            <path d="M120 250 C 200 235, 250 260, 320 240 C 400 216, 470 245, 560 220" fill="none" stroke="#3a6d86" stroke-width="2.4" opacity="0.7"/>
            <text x="500" y="210" fill="#4a7d93" font-size="12" font-style="italic" font-family="Cormorant Garamond, serif">Rio Douro</text>
            <g class="pin"><circle class="dot" cx="300" cy="92" r="5.5"/><circle class="ring" cx="300" cy="92" r="12"/><text x="314" y="96">Gerês</text></g>
            <g class="pin"><circle class="dot" cx="330" cy="188" r="5.5"/><circle class="ring" cx="330" cy="188" r="12"/><text x="344" y="192">Amarante</text></g>
            <g class="pin"><circle class="dot" cx="122" cy="250" r="5.5"/><circle class="ring" cx="122" cy="250" r="12"/><text x="136" y="254">Foz do Douro</text></g>
            <g class="pin"><circle class="dot" cx="486" cy="236" r="5.5"/><circle class="ring" cx="486" cy="236" r="12"/><text x="500" y="240">Pinhão</text></g>
            <g class="pin"><circle class="dot" cx="150" cy="368" r="5.5"/><circle class="ring" cx="150" cy="368" r="12"/><text x="164" y="372">Costa Nova</text></g>
          </svg>
        </div>
        <div class="map-side">
          <div class="coord">41.15° N · 8.61° W</div>
          <h2 class="display">Onde já<br>voámos</h2>
          <p>Cada projeto começa num sítio. Estes são alguns dos locais que já filmámos pelo Norte — e a lista continua a crescer.</p>
          <div class="legend"><span class="chip">Gerês</span><span class="chip">Amarante</span><span class="chip">Foz do Douro</span><span class="chip">Vale do Douro</span><span class="chip">Costa Nova</span></div>
        </div>
      </div>
    </section>

    <section class="blk">
      <div class="grid3">
        <div class="svc lead"><h3>Drone</h3><p>Planos aéreos cinematográficos, órbitas e reveals de paisagem e património.</p></div>
        <div class="svc"><h3>Photo</h3><p>Fotografia aérea e de solo, tratada com uma linguagem visual coerente.</p></div>
        <div class="svc"><h3>Video</h3><p>Edição de reels e peças para marcas, prontos para Instagram e TikTok.</p></div>
      </div>
    </section>

    <section class="blk" style="padding-top:0;">
      <div class="cta"><div class="dots" style="opacity:0.08;"></div>
        <div style="position:relative;">
          <h2 class="display">Vamos criar algo que merece ser <span class="serif" style="font-style:italic;font-weight:600;color:var(--gold);">visto?</span></h2>
          <div class="row"><span class="btn big">Fala connosco</span><span class="handle">@aera_studio__ · Instagram · TikTok</span></div>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap"><footer><span class="mark">AERA</span><span class="fine">Creating visuals that tell stories · Porto, Portugal</span></footer></div>
</main>

  <script is:inline src="/site.js"></script>
</body>
</html>
