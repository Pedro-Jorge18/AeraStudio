  </div>

  <div class="wrap"><footer><span class="mark">AERA</span><span class="fine">Creating visuals that tell stories · Porto, Portugal</span></footer></div>
</main>

  <script is:inline src="/site.js"></script>
</body>
<script is:inline src="https://cdn.jsdelivr.net/npm/globe.gl"></script>
<script is:inline>
  window.addEventListener('load', () => {
    const el = document.getElementById('globo');
    if (!el || typeof Globe === 'undefined') return;

    // 📍 Los lugares. Cambia cada "video" por el link real cuando lo tengas.
    const locais = [
      { nome: 'Gerês',         lat: 41.73, lng: -8.16, video: 'https://www.instagram.com/aera_studio__/' },
      { nome: 'Amarante',      lat: 41.27, lng: -8.08, video: 'https://www.instagram.com/aera_studio__/' },
      { nome: 'Foz do Douro',  lat: 41.15, lng: -8.67, video: 'https://www.instagram.com/aera_studio__/' },
      { nome: 'Vale do Douro', lat: 41.19, lng: -7.55, video: 'https://www.instagram.com/aera_studio__/' },
      { nome: 'Costa Nova',    lat: 40.62, lng: -8.75, video: 'https://www.instagram.com/aera_studio__/' },
    ];

    const globo = Globe()(el)
      .backgroundColor('rgba(0,0,0,0)')     // fondo transparente
      .showGlobe(true)
      .showGraticules(true)                 // las líneas del globo (para ver que gira)
      .showAtmosphere(true)
      .atmosphereColor('#caa15d')           // brillo dorado alrededor
      .atmosphereAltitude(0.15)
      .pointsData(locais)
      .pointLat('lat')
      .pointLng('lng')
      .pointColor(() => '#caa15d')          // puntos dorados
      .pointAltitude(0.03)
      .pointRadius(0.6)
      .pointLabel(d => d.nome)              // el nombre al pasar por encima
      .onPointClick(d => window.open(d.video, '_blank'));  // clic → abre el video

    // color azul AERA del globo
    globo.globeMaterial().color.set('#0e2233');
    globo.globeMaterial().emissive.set('#0a1622');
    globo.globeMaterial().emissiveIntensity = 0.5;

    // tamaño + giro automático
    const ajustar = () => globo.width(el.clientWidth).height(el.clientHeight);
    ajustar();
    window.addEventListener('resize', ajustar);
    globo.controls().autoRotate = true;
    globo.controls().autoRotateSpeed = 0.6;
    globo.controls().enableZoom = false;    // que no haga zoom con la rueda
    globo.pointOfView({ lat: 39.5, lng: -8, altitude: 2.2 });  // empieza mirando Portugal
  });
</script>
</html>
